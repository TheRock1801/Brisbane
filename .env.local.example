# Copy to .env.local and fill in. .env* is gitignored — never commit real values.

# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://vpqwjpgoqvyjmyqzeixv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox → account.mapbox.com/access-tokens (a public "pk." token is fine)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Random secret used to sign the login session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
